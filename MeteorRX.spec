# -*- mode: python ; coding: utf-8 -*-
# PyInstaller spec: dist/MeteorRX/ with MeteorRX.exe (GUI) and MeteorRX-cli.exe (console), one-folder mode.
#   python -m PyInstaller --noconfirm --clean MeteorRX.spec
# Notes
#  - meteorrx is collected as .py source files (module_collection_mode 'py') so that Numba can cache the
#    compiled DSP kernels next to the program; no compiled code of ours is shipped.
#  - no UPX; version resource and icon set (unsigned, version-less, packed executables are what antivirus
#    heuristics dislike most). Use a bootloader rebuilt from source (see build_exe.bat).
# The Windows version resource is generated here from meteorrx.__version__ rather than kept by hand:
# the hand-written file had drifted to 1.6.2 in its binary tuple while its strings said 1.7.2, so the
# executable reported a version nobody had released.
import re as _re
_src = open("meteorrx/__init__.py", encoding="utf-8").read()
_VER = _re.search(r'__version__\s*=\s*"([^"]+)"', _src).group(1)
_T = tuple(int(x) for x in (_VER.split(".") + ["0", "0", "0"])[:3]) + (0,)
open("tools/version_info.txt", "w", encoding="utf-8").write(f"""\
# Generated by MeteorRX.spec from meteorrx.__version__ - do not edit by hand.
VSVersionInfo(
  ffi=FixedFileInfo(filevers={_T}, prodvers={_T}, mask=0x3f, flags=0x0, OS=0x40004,
                    fileType=0x1, subtype=0x0, date=(0, 0)),
  kids=[
    StringFileInfo([StringTable('040904B0', [
      StringStruct('CompanyName', 'Malta Amateur Radio League (MARL) - 9H2WB'),
      StringStruct('FileDescription', 'MeteorRX - Meteor-M LRPT weather satellite receiver'),
      StringStruct('FileVersion', '{_VER}'),
      StringStruct('InternalName', 'MeteorRX'),
      StringStruct('LegalCopyright', 'GPL-3.0 - (C) 2026 9H2WB / F5OWB'),
      StringStruct('OriginalFilename', 'MeteorRX.exe'),
      StringStruct('ProductName', 'MeteorRX'),
      StringStruct('ProductVersion', '{_VER}')])]),
    VarFileInfo([VarStruct('Translation', [1033, 1200])])
  ]
)
""")

excludes = ["scipy", "matplotlib", "tkinter", "pytest", "IPython", "PIL", "pandas",
            "PySide6.QtWebEngineCore", "PySide6.QtWebEngineWidgets", "PySide6.QtQml", "PySide6.QtQuick",
            "PySide6.Qt3DCore", "PySide6.QtMultimedia", "PySide6.QtPdf", "PySide6.QtCharts", "PySide6.QtSql",
            "PySide6.QtDataVisualization", "PySide6.QtTest", "PySide6.QtDesigner", "PySide6.QtBluetooth",
            "PySide6.QtOpenGL", "PySide6.QtSvg", "PySide6.QtXml", "PySide6.QtSerialPort",
            # unused optional parts that only produce build warnings: NumPy's experimental array API and
            # Numba's TBB threading layer (needs tbb12.dll; MeteorRX does not use parallel=True)
            "numpy.array_api", "numba.np.ufunc.tbbpool"]
common = dict(
    pathex=["."],
    datas=[("assets/meteorrx.png", "assets"), ("assets/meteorrx.ico", "assets"),
           # map overlay data, loaded by meteorrx/overlay.py from beside the package
           ("meteorrx/data/coastline.bin.gz", "meteorrx/data"),
           ("meteorrx/data/cities.tsv.gz", "meteorrx/data"),
           ("meteorrx/data/font.bin.gz", "meteorrx/data")],
    hiddenimports=["sgp4.api", "sgp4.wrapper", "certifi", "PySide6.QtNetwork", "meteorrx.dsp", "meteorrx.selftest",
                   "meteorrx.drivers", "meteorrx.cli", "meteorrx.gui", "meteorrx.calib", "meteorrx.caldialog",
                   "meteorrx.outputs", "meteorrx.profiles", "meteorrx.audio",
                   "meteorrx.hackrf", "meteorrx.lime", "meteorrx.pluto", "meteorrx.i18n",
                   "meteorrx.geometry", "meteorrx.enhance", "meteorrx.geo", "meteorrx.overlay"],
    excludes=excludes,
    module_collection_mode={"meteorrx": "py"},
    noarchive=False,
)
a = Analysis(["MeteorRX_gui.py"], **common)
b = Analysis(["MeteorRX_cli.py"], **common)
exe_gui = EXE(PYZ(a.pure), a.scripts, [], exclude_binaries=True, name="MeteorRX", console=False,
              icon="assets/meteorrx.ico", version="tools/version_info.txt", upx=False)
exe_cli = EXE(PYZ(b.pure), b.scripts, [], exclude_binaries=True, name="MeteorRX-cli", console=True,
              icon="assets/meteorrx.ico", version="tools/version_info.txt", upx=False)
coll = COLLECT(exe_gui, a.binaries, a.datas, exe_cli, b.binaries, b.datas, strip=False, upx=False, name="MeteorRX")
